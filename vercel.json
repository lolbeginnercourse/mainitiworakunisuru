{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.microcms-assets.io; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "0",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "Cross-Origin-Opener-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/$",
      "dest": "/api/home"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/search$",
      "status": 308,
      "headers": {
        "Location": "/search/"
      }
    },
    {
      "src": "^/search/$",
      "dest": "/api/search"
    },
    {
      "src": "^/articles$",
      "status": 308,
      "headers": { "Location": "/articles/" }
    },
    {
      "src": "^/articles/$",
      "dest": "/api/articles"
    },
    {
      "src": "^/articles/([^/]+)$",
      "status": 308,
      "headers": { "Location": "/articles/$1/" }
    },
    {
      "src": "^/articles/([^/]+)/$",
      "dest": "/api/article?id=$1"
    },
    {
      "src": "^/leaks/$",
      "dest": "/api/articles?category=リーク&hub=leaks"
    },
    {
      "src": "^/(news|official)/?$",
      "status": 308,
      "headers": {
        "Location": "/release/"
      }
    },
    {
      "src": "^/(news|official|category|release|characters|vehicles|systems|online|leaks|guide|about|editorial-policy|source-policy|corrections|privacy-policy|contact)$",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "^/(news|official|category|release|characters|vehicles|systems|online|leaks|guide|about|editorial-policy|source-policy|corrections|privacy-policy|contact)/$",
      "dest": "/$1/index.html"
    },
    {
      "src": "^/authors/editorial-team$",
      "status": 308,
      "headers": {
        "Location": "/authors/editorial-team/"
      }
    },
    {
      "src": "^/authors/editorial-team/$",
      "dest": "/authors/editorial-team/index.html"
    },
    {
      "src": "^/map$",
      "status": 308,
      "headers": {
        "Location": "/map/"
      }
    },
    {
      "src": "^/map/$",
      "dest": "/map/index.html"
    },
    {
      "src": "^/map/(vice-city|leonida-keys|grassrivers|port-gellhorn|ambrosia|mount-kalaga)$",
      "status": 308,
      "headers": {
        "Location": "/map/$1/"
      }
    },
    {
      "src": "^/map/(vice-city|leonida-keys|grassrivers|port-gellhorn|ambrosia|mount-kalaga)/$",
      "dest": "/map/$1/index.html"
    },
    {
      "src": "^/map/.*$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/robots.txt"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/404\\.html$",
      "dest": "/404.html"
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    }
  ]
}
