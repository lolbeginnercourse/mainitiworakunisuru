{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/search$",
      "status": 308,
      "headers": {
        "Location": "/search/"
      }
    },
    {
      "src": "^/search/$",
      "dest": "/api/search"
    },
    {
      "src": "^/(news|official)/?$",
      "status": 308,
      "headers": {
        "Location": "/release/"
      }
    },
    {
      "src": "^/(news|official|category|release|characters|vehicles|systems|online|leaks|guide|about|editorial-policy|source-policy|corrections|privacy-policy|contact)$",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "^/(news|official|category|release|characters|vehicles|systems|online|leaks|guide|about|editorial-policy|source-policy|corrections|privacy-policy|contact)/$",
      "dest": "/$1/index.html"
    },
    {
      "src": "^/authors/editorial-team$",
      "status": 308,
      "headers": {
        "Location": "/authors/editorial-team/"
      }
    },
    {
      "src": "^/authors/editorial-team/$",
      "dest": "/authors/editorial-team/index.html"
    },
    {
      "src": "^/map$",
      "status": 308,
      "headers": {
        "Location": "/map/"
      }
    },
    {
      "src": "^/map/$",
      "dest": "/map/index.html"
    },
    {
      "src": "^/map/(vice-city|leonida-keys|grassrivers|port-gellhorn|ambrosia|mount-kalaga)$",
      "status": 308,
      "headers": {
        "Location": "/map/$1/"
      }
    },
    {
      "src": "^/map/(vice-city|leonida-keys|grassrivers|port-gellhorn|ambrosia|mount-kalaga)/$",
      "dest": "/map/$1/index.html"
    },
    {
      "src": "^/map/.*$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "^/(robots\\.txt|sitemap\\.xml)$",
      "dest": "/$1"
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/404\\.html$",
      "dest": "/404.html"
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    }
  ]
}
